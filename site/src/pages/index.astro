---
import Base from '../layouts/Base.astro';
import { loadResults } from '../lib/data.js';
const r = loadResults();
const p = r.pooled;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Base title="Autonomous mowing on real golf courses — measured results"
      description="Measured labor, time and cost results from autonomous fairway mowing trials at working golf courses.">

  <div class="hero">
    <div class="wrap">
      <p class="eyebrow">Auburn University turfgrass program &middot; field study</p>
      <h1>We timed autonomous mowing against manual mowing on working golf courses.</h1>
      <p>
        Not a manufacturer's estimate. Minute-by-minute logs from {p.sites} courses across
        {p.sessions} mowing sessions and {p.acres_observed} acres of fairway, recording what the
        machine did, what the operator did, and what the operator did instead.
      </p>
    </div>
  </div>

  <div class="widget">
    <div class="wrap">
      <div class="kpis">
        <div class="kpi">
          <div class="kpi-n">{p.labor_saved_hr}</div>
          <div class="kpi-l">operator hours freed<em>across {p.acres_observed} acres mowed</em></div>
        </div>
        <div class="kpi">
          <div class="kpi-n">{p.labor_reduction_pct}<span>%</span></div>
          <div class="kpi-l">less operator time<em>{p.manual_labor_min_per_ac} → {p.auto_labor_min_per_ac} min per acre</em></div>
        </div>
        <div class="kpi">
          <div class="kpi-n">{p.redeployed_hr}</div>
          <div class="kpi-l">hours of other work done<em>logged at {p.redeployed_sites} of {p.sites} sites</em></div>
        </div>
        <div class="kpi">
          <div class="kpi-n">{p.auto_machine_min_per_ac}<span> min</span></div>
          <div class="kpi-l">machine time per acre<em>vs {p.manual_machine_min_per_ac} manual</em></div>
        </div>
      </div>

      <p class="sub" style="margin-top:26px">
        The headline is not that the robot mows faster. Per machine it is close to parity. The
        headline is that mowing stopped consuming an operator&rsquo;s morning.
      </p>
      <p style="margin-top:18px">
        <a class="btn" href={base + '/results/'}>See the full results</a>
        <a class="btn ghost" href={base + '/contribute/'}>Add your course to the study</a>
      </p>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <h2 class="section-title">What we measured at each site</h2>
      <p class="section-lede">
        Courses are identified by facility type, region and turf system only. No course names,
        no superintendent names, no exact locations.
      </p>
      <div class="grid">
        {r.sites.map((s) => (
          <a class="card" href={base + '/results/' + s.code + '/'}>
            <div class="vendor">{s.facility_type} &middot; {s.region}</div>
            <div class="model">{s.labor_saved_hr} hours freed</div>
            <div class="meta">
              {s.turf} &middot; {s.acres_observed} ac observed<br />
              {s.manual_labor_min_per_ac} → {s.auto_labor_min_per_ac} operator-min per acre
              ({s.labor_reduction_pct}% less)<br />
              {s.redeployed_log
                ? `${(s.redeployed_min / 60).toFixed(1)} hr of other work logged`
                : 'Redeployed work not logged'}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2 class="section-title">Read this before you use the numbers</h2>
      <p class="section-lede">
        Three courses is a direction, not a finding. Every caveat that applies is published
        alongside the results rather than buried in a footnote.
      </p>
      <div class="gaps">
        <h3>Limits of this dataset</h3>
        <ul>{r.caveats.map((c) => <li>{c}</li>)}</ul>
      </div>
      <p>
        <a class="btn" href={base + '/contribute/'}>Help us fix that — submit your data</a>
      </p>
    </div>
  </section>
</Base>
