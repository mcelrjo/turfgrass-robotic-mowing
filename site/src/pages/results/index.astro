---
import Base from '../../layouts/Base.astro';
import { loadResults } from '../../lib/data.js';
const r = loadResults();
const p = r.pooled;
const e = r.economics;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const F = p.default_mow_freq;
const w = (s) => s.normalized.weekly.find((x) => x.mow_freq_per_week === F);
---
<Base title="Results — measured autonomous mowing trials" description="Man-hours saved, method, and site-by-site results from autonomous fairway mowing trials.">
  <div class="hero">
    <div class="wrap">
      <p class="eyebrow">{p.sites} sites &middot; {p.sessions} sessions &middot; {p.observed_acres} acres measured</p>
      <h1>Results</h1>
      <p>{r.method_note}</p>
    </div>
  </div>

  <section class="band">
    <div class="wrap">
      <p class="level-note">Level 3 — normalized</p>
      <h2 class="section-title">Man-hours per week on a standard {p.reference_acres}-acre course</h2>
      <p class="section-lede">
        This is the comparable number. Each site's own measured coefficients, applied to the same
        course, at {F} mowings per week.
      </p>
      <table class="spec">
        <thead><tr><th style="width:auto">Site</th><th>Manual</th><th>Autonomous</th><th>Saved</th><th>Reduction</th></tr></thead>
        <tbody>
          {r.sites.map((s) => (
            <tr>
              <th><a href={base + '/results/' + s.code + '/'}>{s.facility_type}, {s.region}</a></th>
              <td>{w(s).manual_hr_per_week} hr/wk</td>
              <td>{w(s).auto_hr_per_week} hr/wk</td>
              <td>{w(s).saved_hr_per_week} hr/wk</td>
              <td>{s.normalized.reduction_pct}%</td>
            </tr>
          ))}
        </tbody>
      </table>
      <table class="spec">
        <caption>At other mowing frequencies — saved hours per week</caption>
        <thead><tr><th style="width:auto">Site</th>
          {p.normalized.weekly.map((x) => <th>{x.mow_freq_per_week}&times;/wk</th>)}</tr></thead>
        <tbody>
          {r.sites.map((s) => (
            <tr><th>{s.facility_type}, {s.region}</th>
              {s.normalized.weekly.map((x) => <td>{x.saved_hr_per_week} hr</td>)}</tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.85rem;color:var(--slate);max-width:66ch">
        No site reported its mowing frequency, so this is the reader's input rather than a
        measurement. It is now a required field for new participants.
      </p>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2 class="section-title">Why the sites converge here but not in the raw data</h2>
      <p class="section-lede">
        Observed hours are not comparable — one site logged {Math.max(...r.sites.map((s) => s.observed.acres))} acres
        and another {Math.min(...r.sites.map((s) => s.observed.acres))}. Rates are comparable, and they are
        consistent across all three.
      </p>
      <table class="spec">
        <caption>Labor model</caption>
        <tbody>
          <tr><th>Autonomous, fixed per session</th><td>{p.coefficients.auto_fixed_min_per_session} min</td></tr>
          <tr><th>Autonomous, shepherding per session</th><td>{p.coefficients.auto_shepherd_min_per_session} min</td></tr>
          <tr><th>Manual, fixed per unit-session</th><td>{p.coefficients.manual_fixed_min_per_unit_session} min</td></tr>
          <tr><th>Manual, variable per acre</th><td>{p.coefficients.manual_variable_min_per_ac} min/ac</td></tr>
          <tr><th>Autonomous session capacity</th><td>{p.auto_session_cap_ac} ac per unit per session</td></tr>
        </tbody>
      </table>
      <div class="gaps">
        <h3>The asymmetry, stated plainly</h3>
        <ul>
          <li>Manual labor scales with acreage — someone rides the machine for every acre.</li>
          <li>Autonomous labor scales with sessions — someone starts it and collects it.</li>
          <li>So the saving grows with course size and with mowing frequency.</li>
          <li>And a site that mows more acres per session looks better in raw data purely because its fixed overhead is spread further.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <p class="level-note">Level 2 — each course's own fairways</p>
      <h2 class="section-title">What each participating course actually gets</h2>
      <table class="spec">
        <thead><tr><th style="width:auto">Site</th><th>Managed fairway</th><th>Basis</th>
          <th>Saved per pass</th><th>Saved per week at {F}&times;</th></tr></thead>
        <tbody>
          {r.sites.map((s) => (
            <tr>
              <th>{s.facility_type}, {s.region}</th>
              <td>{s.full_course.acres} ac</td>
              <td>{s.full_course.is_extrapolated
                ? `measured on ${s.observed.fairways} of ${s.holes_managed}, scaled ×${s.full_course.scale_factor}`
                : 'fully measured'}</td>
              <td>{s.full_course.saved_hr} hr</td>
              <td>{s.full_course.weekly.find((x) => x.mow_freq_per_week === F).saved_hr_per_week} hr</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <p class="level-note">Level 1 — as measured</p>
      <h2 class="section-title">The raw observations</h2>
      <p class="section-lede">
        Everything above is built from these. Published so anyone can check the arithmetic.
      </p>
      <table class="spec">
        <thead><tr><th style="width:auto">Site</th><th>Acres</th><th>Manual</th><th>Autonomous</th><th>Saved</th></tr></thead>
        <tbody>
          {r.sites.map((s) => (
            <tr>
              <th>{s.facility_type}, {s.region}</th>
              <td>{s.observed.acres}{s.observed.acres_basis === 'estimated' ? '*' : ''}</td>
              <td>{s.observed.manual_min} min ({s.observed.manual_min_per_ac}/ac)</td>
              <td>{s.observed.auto_min} min ({s.observed.auto_min_per_ac}/ac)</td>
              <td>{s.observed.saved_hr} hr</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p style="font-size:0.82rem;color:var(--slate)">* Acreage estimated from the pooled autonomous mowing rate; the site did not report acres.</p>
    </div>
  </section>

  <section class="band">
    <div class="wrap">
      <h2 class="section-title">Where the freed hours went</h2>
      <p class="section-lede">
        Two of {p.sites} sites logged what the operator did while the machine mowed —
        {p.redeployed_hr} hours of agronomic work that would otherwise have waited.
      </p>
      <table class="spec">
        <caption>Work completed during autonomous mowing</caption>
        <tbody>{r.redeployed_tasks.map((t) => <tr><th>{t.task}</th><td>{t.hours} hr</td></tr>)}</tbody>
      </table>
      <div class="gaps">
        <h3>Why hours, not dollars</h3>
        <ul>
          <li>No participating course has cut headcount or overtime.</li>
          <li>The saving is work gained, not cash removed from a budget.</li>
          <li>For scale: {p.normalized.weekly.find((x) => x.mow_freq_per_week === F).saved_hr_per_week} hr/week
              at ${e.wage_default_usd_hr}/hr is about ${e.reference_weekly_value_default.toLocaleString()}/week,
              ${e.reference_annual_value_default.toLocaleString()} over a 30-week season.</li>
          <li>Treat that as the value of the work done, not money a club can bank.</li>
        </ul>
      </div>
      <table class="spec" style="margin-top:24px">
        <caption>Energy — the one unambiguous cash line</caption>
        <tbody>
          <tr><th>Diesel, manual</th><td>{e.fuel_gal_per_ac} gal/ac &rarr; ${e.fuel_cost_per_ac}/ac</td></tr>
          <tr><th>Electricity, autonomous (estimated)</th><td>{e.kwh_per_ac_estimated} kWh/ac &rarr; ${e.electric_cost_per_ac}/ac</td></tr>
          <tr><th>Saving</th><td>${e.energy_saved_per_ac}/ac</td></tr>
        </tbody>
      </table>
    </div>
  </section>

  <section class="band alt">
    <div class="wrap">
      <h2 class="section-title">Limits</h2>
      <div class="gaps"><ul>{r.caveats.map((c) => <li>{c}</li>)}</ul></div>
      <p style="margin-top:22px"><a class="btn" href={base + '/contribute/'}>Submit your course data</a></p>
    </div>
  </section>
</Base>
